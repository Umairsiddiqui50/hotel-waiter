PROJECT_NAME="Smart Table Service"
ENVIRONMENT=development
DEBUG=True

# Target Production Database (PostgreSQL)
POSTGRES_DB=hotel_waiter_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# For PostgreSQL production, set:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hotel_waiter_db

# Local development/testing fallback:
DATABASE_URL=sqlite+aiosqlite:///./hotel_waiter.db

# Security & Secrets (Must be changed in production)
SECRET_KEY=dev_secret_key_change_in_production_1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Dev Seed Credentials
DEV_DEFAULT_PASSWORD=DevOnly_ChangeMe!123

# Payment Gateway Configuration (Razorpay Sandbox / Live)
RAZORPAY_KEY_ID=rzp_test_hotelwaiterdemo123
RAZORPAY_KEY_SECRET=sec_test_secret9876543210
